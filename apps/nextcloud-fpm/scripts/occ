#!/bin/sh

# Re-run this script as the web server user, so everything below, including the
# opcache directory, is created as that user and not as root.
# The `--` stops su from parsing the occ arguments (eg --value) as its own.
if [ "$(id -u)" = 0 ]; then
  # shellcheck disable=SC2016 # Expanded by the inner shell, from the arguments after the user
  exec su -p -s /bin/sh -c 'exec "$0" "$@"' -- www-data "$0" "$@"
fi

# Every occ call is a fresh php process that recompiles nextcloud from source.
# A file based opcache keeps the compiled bytecode around between calls, which
# is worth it because a single startup makes around a hundred of them.
# This is only for the cli, php-fpm keeps using its shared memory opcache.
occ='/var/www/html/occ'
opcache_dir='/tmp/.occ-opcache'
if mkdir -p "$opcache_dir" 2>/dev/null; then
  exec php -d opcache.enable_cli=1 -d opcache.file_cache="$opcache_dir" -d opcache.file_cache_only=1 "$occ" "$@"
fi

exec php "$occ" "$@"
