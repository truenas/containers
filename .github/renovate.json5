{
  enabled: true,
  dependencyDashboard: true,
  dependencyDashboardTitle: "🤖 Renovate Dashboard",
  automerge: false,
  gitAuthor: "bugclerk <bugclerk@ixsystems.com>",
  reviewers: ["stavros-k"],
  rebaseWhen: "conflicted",
  packageRules: [
    {
      enabled: true,
      matchManagers: ["dockerfile"],
      matchUpdateTypes: ["patch", "minor", "major"],
    },
    {
      matchManagers: ["dockerfile"],
      pinDigests: true,
    },
    {
      // same-tag rebuilds (e.g. base image security fixes); 1st and 15th of each month
      matchManagers: ["dockerfile"],
      matchUpdateTypes: ["digest"],
      schedule: ["* * 1,15 * *"],
      addLabels: ["digest"],
    },
    {
      enabled: true,
      matchDatasources: ["github-releases"],
      matchUpdateTypes: ["patch", "minor", "major"],
    },
    {
      // apt pins in rsyncd; the security repo carries CVE fixes before they reach main
      matchFileNames: ["apps/rsyncd/Dockerfile"],
      matchDatasources: ["deb"],
      registryUrls: [
        "https://deb.debian.org/debian?suite=trixie&components=main&binaryArch=amd64",
        "https://security.debian.org/debian-security?suite=trixie-security&components=main&binaryArch=amd64",
      ],
    },
    {
      matchDepTypes: ["action"],
      addLabels: ["actions"],
    },
    {
      matchUpdateTypes: ["major"],
      addLabels: ["major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["patch"],
    },
  ],
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/Dockerfile/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\sENV .*?_VERSION=(?<currentValue>.*)",
      ],
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
  ],
}
